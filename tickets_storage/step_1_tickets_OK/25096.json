        "body": "<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" align=\"center\" style=\"width:100%;\"><tbody><tr><td align=\"left\">\n<div> </div>\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" align=\"center\" style=\"width:100%;\"><tbody><tr><td style=\"background-color: #fef7e0;color: #340f03;padding: 12px 32px;font-size: 14px;text-align: left;\">Amin Ghaffari has accepted this invitation.</td></tr></tbody></table>\n<div> </div>\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" align=\"center\" style=\"width:100%;\"><tbody><tr><td style=\"border: solid 1px #dadce0; padding: 24px 32px; text-align: center; vertical-align: top;\">\n<div><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;\"><tbody><tr><td style=\"vertical-align:top;padding:0;\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;\">\n<tr><td style=\" padding: 0; text-align: left;padding-bottom:28px;\">\n<a href=\"https://meet.google.com/mrk-wqwb-zkv?hs=224\" rel=\"nofollow noreferrer noopener\" title=\"https://meet.google.com/mrk-wqwb-zkv?hs=224\" target=\"_blank\"></a><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" valign=\"middle\" style=\"background-color: #1a73e8; padding: 10px 25px; border: none; margin: 0;\">Join with Google Meet</td></tr></table>\n</td></tr>\n<tr><td style=\" padding: 0; text-align: left;padding-bottom:24px;\"><div>\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding-bottom: 4px;\"><tr><td><h2>Meeting link</h2></td></tr></table>\n<div style=\"color: #70757a;\"><a href=\"https://meet.google.com/mrk-wqwb-zkv?hs=224\" rel=\"nofollow noreferrer noopener\" title=\"https://meet.google.com/mrk-wqwb-zkv?hs=224\" target=\"_blank\">meet.google.com/mrk-wqwb-zkv</a></div>\n</div></td></tr>\n<tr><td style=\" padding: 0; text-align: left;padding-bottom:24px;\"><div>\n<a href=\"https://meet.google.com/mrk-wqwb-zkv?hs=224\" rel=\"nofollow noreferrer noopener\" title=